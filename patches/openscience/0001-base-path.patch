@@ -0,0 +1,24 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { terminalEndpointAvailable } from "./terminal-endpoint"
+
+const origin = "https://lab.example.org"
+
+afterEach(() => {
+  if (typeof window === "object") delete window.__OPENSCIENCE_TRUSTED_PROXY__
+})
+
+describe("terminalEndpointAvailable", () => {
+  test("allows loopback servers", () => {
+    expect(terminalEndpointAvailable("http://127.0.0.1:4096", origin)).toBe(true)
+    expect(terminalEndpointAvailable("/pty", "http://localhost:3000")).toBe(true)
+  })
+
+  test("refuses remote servers unless a same-origin proxy vouches for them", () => {
+    const server = `${origin}/session/abc/openscience`
+    expect(terminalEndpointAvailable(server, origin)).toBe(false)
+    if (typeof window !== "object") return
+    window.__OPENSCIENCE_TRUSTED_PROXY__ = true
+    expect(terminalEndpointAvailable(server, origin)).toBe(true)
+    expect(terminalEndpointAvailable("https://other.example.org", origin)).toBe(false)
+  })
+})
