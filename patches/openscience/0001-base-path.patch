+/** Path a reverse proxy mounts the workspace under (for example
+ * `/session/abc/openscience`), announced by the proxy through
+ * `window.__OPENSCIENCE_BASE_URL__`. Empty when served from the site root. */
+export function resolveBasePath(value = typeof window === "object" ? window.__OPENSCIENCE_BASE_URL__ : undefined) {
+  if (!value) return ""
+  try {
+    return new URL(value, "http://base.invalid").pathname.replace(/\/+$/, "")
+  } catch {
+    return ""
+  }
+}
+
+/** A same-origin default stored under another mount (an earlier proxied
+ * session) points at a path this proxy no longer serves. */
+function staleMountedDefault(input: DefaultServerInput, base: string) {
+  if (!base || !input.stored) return false
+  try {
+    const stored = new URL(input.stored)
+    return stored.origin === input.origin && stored.pathname.replace(/\/+$/, "") !== base
+  } catch {
+    return false
+  }
+}
+
+export function resolveDefaultServerUrl(input: DefaultServerInput, base = resolveBasePath()) {
   if (input.explicit) return input.explicit
-  if (input.stored && !staleLoopbackDefault(input)) return input.stored
+  if (input.stored && !staleLoopbackDefault(input) && !staleMountedDefault(input, base)) return input.stored
   if (input.configured) return input.configured
   if (input.dev) return "http://localhost:4096"
-  return input.origin
+  return input.origin + base
 }
 
