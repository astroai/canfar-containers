--- a/frontend/workspace/src/atlas/terminal-endpoint.ts
+++ b/frontend/workspace/src/atlas/terminal-endpoint.ts
@@ -1,10 +1,20 @@
 const loopback = new Set(["localhost", "127.0.0.1", "::1", "[::1]"])
 
+/** An authenticating reverse proxy that serves the workspace and the server
+ * from one origin may vouch for the terminal by setting
+ * `window.__OPENSCIENCE_TRUSTED_PROXY__ = true`. */
+function trustedProxy(url: URL, base: string | undefined) {
+  if (typeof window !== "object" || window.__OPENSCIENCE_TRUSTED_PROXY__ !== true) return false
+  return !!base && URL.canParse(base) && url.origin === new URL(base).origin
+}
+
 export function terminalEndpointAvailable(value: string, origin?: string) {
   const base = origin ?? (typeof location === "object" ? location.origin : undefined)
   if (URL.canParse(value)) {
-    return loopback.has(new URL(value).hostname)
+    const url = new URL(value)
+    return loopback.has(url.hostname) || trustedProxy(url, base)
   }
   if (!base || !URL.canParse(base) || !URL.canParse(value, base)) return false
-  return loopback.has(new URL(value, base).hostname)
+  const url = new URL(value, base)
+  return loopback.has(url.hostname) || trustedProxy(url, base)
 }
